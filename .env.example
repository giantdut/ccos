# ─── Required ────────────────────────────────────────────────────────────────

# Anthropic API key — used by all Claude agents (research, scheduling, drafting).
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Required for web research ───────────────────────────────────────────────

# Firecrawl API key — used to search YouTube, Reddit, Hacker News, Medium, and
# Substack during Planning sessions. Without this, web sources return no results
# and the Research bundle will be empty.
# Get yours at https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# ─── Required for container deploy (docker-compose) ──────────────────────────

# HTTP basic-auth credentials enforced by Caddy.
# OPERATOR_USER: the username you will type when the browser prompts you.
# OPERATOR_PASS_HASH: bcrypt hash of your chosen password. Generate it with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext yourpassword
OPERATOR_USER=operator
OPERATOR_PASS_HASH=

# ─── Optional overrides ──────────────────────────────────────────────────────

# Absolute path to the SQLite database file.
# Defaults to ./ccos.db in the working directory (dev) or /data/ccos.db (container).
# DATABASE_URL=/data/ccos.db

# Absolute path to the CLAUDE.md file that stores the Brand profile.
# Defaults to ./CLAUDE.md in the working directory.
# BRAND_PROFILE_PATH=./CLAUDE.md

# Directory where knowledge upload files are stored on disk.
# Defaults to ./uploads in the working directory.
# UPLOADS_DIR=./uploads
